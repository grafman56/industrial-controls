<?xml version="1.0" encoding="utf-8"?>
<!--
  IEC 61131-3 instruction list, PLCopen TC6 XML.

  Same control logic as level_control_ld.xml, one instruction per line. The
  accumulator model is the thing to learn here: LD loads it, AND and OR
  combine with it, ST writes it out.

  Instruction list is deprecated in the 2013 edition of the standard and most
  vendors no longer offer it as an authoring language. It is still the easiest
  way to read what a compiler does with the other four languages.
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <fileHeader companyName="Industrial Controls lab" productName="OpenPLC Editor" productVersion="1" creationDateTime="2026-11-02T12:00:00"/>
  <contentHeader name="level_control_il">
    <coordinateInfo>
      <fbd><scaling x="10" y="10"/></fbd>
      <ld><scaling x="10" y="10"/></ld>
      <sfc><scaling x="10" y="10"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="level_control_il" pouType="program">
        <interface>
          <localVars>
            <variable name="start_cmd"><type><BOOL/></type></variable>
            <variable name="level_high"><type><BOOL/></type></variable>
            <variable name="interlock"><type><BOOL/></type></variable>
            <variable name="run_latch"><type><BOOL/></type></variable>
            <variable name="pump_run"><type><BOOL/></type></variable>
          </localVars>
        </interface>
        <body>
          <IL>
            <xhtml:p><![CDATA[
(* Rung 1: seal-in with a high level stop. *)
LD   start_cmd
OR   run_latch
ANDN level_high
ST   run_latch

(* Rung 2: the latch drives the pump only while the interlock is closed. *)
LD   run_latch
ANDN interlock
ST   pump_run
]]></xhtml:p>
          </IL>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
</project>
