<?xml version="1.0" encoding="utf-8"?>
<!--
  IEC 61131-3 ladder diagram, PLCopen TC6 XML.

  Same control logic as level_control_st.xml and level_control_il.xml, written
  as rungs. Open it in the OpenPLC Editor with the PLCopen import, or read it
  as a reference for the rung layout.

  Signals are discrete, as they would be from float switches:
    start_cmd   operator start pushbutton, normally open
    level_high  high level float switch, closed at high level
    interlock   pump protection, closed means the pump may run
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <fileHeader companyName="Industrial Controls lab" productName="OpenPLC Editor" productVersion="1" creationDateTime="2026-11-02T12:00:00"/>
  <contentHeader name="level_control_ld">
    <coordinateInfo>
      <fbd><scaling x="10" y="10"/></fbd>
      <ld><scaling x="10" y="10"/></ld>
      <sfc><scaling x="10" y="10"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="level_control_ld" pouType="program">
        <interface>
          <localVars>
            <variable name="start_cmd"><type><BOOL/></type></variable>
            <variable name="level_high"><type><BOOL/></type></variable>
            <variable name="interlock"><type><BOOL/></type></variable>
            <variable name="run_latch"><type><BOOL/></type></variable>
            <variable name="pump_run"><type><BOOL/></type></variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <!-- Rung 1: seal-in. Start OR already running, and not high level. -->
            <leftPowerRail localId="1" width="10" height="30">
              <position x="0" y="10"/>
              <connectionPointOut formalParameter=""><relPosition x="10" y="20"/></connectionPointOut>
            </leftPowerRail>
            <contact localId="2" negated="false" width="21" height="20">
              <position x="40" y="10"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="1"><position x="-10" y="20"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>start_cmd</variable>
            </contact>
            <contact localId="3" negated="false" width="21" height="20">
              <position x="40" y="30"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="1"><position x="-10" y="20"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>run_latch</variable>
            </contact>
            <contact localId="4" negated="true" width="21" height="20">
              <position x="100" y="20"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="2"><position x="21" y="10"/></connection>
                <connection refLocalId="3"><position x="21" y="10"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>level_high</variable>
            </contact>
            <coil localId="5" negated="false" width="21" height="20">
              <position x="160" y="20"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="4"><position x="21" y="10"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>run_latch</variable>
            </coil>
            <rightPowerRail localId="6" width="10" height="20">
              <position x="200" y="20"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="5"><position x="21" y="10"/></connection>
              </connectionPointIn>
            </rightPowerRail>
            <!-- Rung 2: the latch drives the pump only while the interlock is closed. -->
            <leftPowerRail localId="10" width="10" height="20">
              <position x="0" y="80"/>
              <connectionPointOut formalParameter=""><relPosition x="10" y="10"/></connectionPointOut>
            </leftPowerRail>
            <contact localId="11" negated="false" width="21" height="20">
              <position x="40" y="80"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="10"><position x="-10" y="10"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>run_latch</variable>
            </contact>
            <contact localId="12" negated="true" width="21" height="20">
              <position x="100" y="80"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="11"><position x="21" y="10"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>interlock</variable>
            </contact>
            <coil localId="13" negated="false" width="21" height="20">
              <position x="160" y="80"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="12"><position x="21" y="10"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>pump_run</variable>
            </coil>
            <rightPowerRail localId="14" width="10" height="20">
              <position x="200" y="80"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="13"><position x="21" y="10"/></connection>
              </connectionPointIn>
            </rightPowerRail>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
</project>
